<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Local (ad-hoc) builds only. Ad-hoc signatures have no Team ID, so the hardened runtime
     would refuse to load the bundled Sparkle.framework. Developer ID builds don't use this:
     app and framework share a Team ID there. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.disable-library-validation</key><true/>
</dict>
</plist>
